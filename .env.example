# ══════════════════════════════════════════════
# Edificio XYZ System — Variables de Entorno
# Copia este archivo como .env en cada paquete
# ══════════════════════════════════════════════

# ─── Base de Datos (compartida por web y api) ───
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres?schema=edificio"

# ─── JWT (DEBE ser idéntico en web y api) ───────
# Generar en producción: openssl rand -base64 64
JWT_SECRET="edificio_xyz_super_secure_jwt_secret_key_2026"

# ─── Frontend (frontend) ────────────────────────
# Puerto del servidor Next.js
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── Backend (backend) ─────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
