# ══════════════════════════════════════════════
# apps/web — Variables de Entorno (Next.js)
# ══════════════════════════════════════════════

# Base de Datos PostgreSQL (usada por Server Components y API Routes)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres?schema=edificio"

# JWT Secret para firmar/verificar sesiones
# DEBE coincidir con el JWT_SECRET de apps/api
JWT_SECRET="edificio_xyz_super_secure_jwt_secret_key_2026"

# URL del backend Express (accesible desde el cliente)
NEXT_PUBLIC_API_URL="http://localhost:4000"
