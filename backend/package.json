{
  "name": "@edificio-xyz/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter @edificio-xyz/database build && tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:t29": "tsx scripts/verificar_consistencia_post_despliegue.ts",
    "check:t36": "tsx scripts/verificar_t35_t36_movimientos.ts",
    "check:t37-t38": "tsx scripts/verificar_t37_t38.ts"
  },
  "dependencies": {
    "@edificio-xyz/database": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jose": "^5.9.6",
    "node-cron": "^4.6.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@edificio-xyz/typescript-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  }
}
