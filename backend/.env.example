# ══════════════════════════════════════════════════════════════
# UBICACIÓN EN EL PROYECTO: /backend/.env.example
# DESCRIPCIÓN: Plantilla de ejemplo. Copiar como /backend/.env
# ══════════════════════════════════════════════════════════════

# Base de Datos PostgreSQL
# Opción 1 (Activa): Supabase Cloud (Modo Transaction Pooler en puerto 6543)
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST.pooler.supabase.com:6543/postgres?schema=edificio&pgbouncer=true&connection_limit=5&pool_timeout=10"
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST.pooler.supabase.com:5432/postgres?schema=edificio"

# Opción 2 (Local): Docker PostgreSQL (descomentar para trabajo offline con Docker Desktop)
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres?schema=edificio"
# DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres?schema=edificio"
# FALLBACK_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres?schema=edificio"


# Opción 3: Render Cloud PostgreSQL (Frankfurt)
# DATABASE_URL="postgresql://edificio_5hlu_user:m4NlbpxERlqyxUgS82Bs026mIrIYA6e5@dpg-db5ro4g473hc73c6dppg-a.frankfurt-postgres.render.com/edificio_5hlu?schema=edificio&sslmode=require"
# DIRECT_URL="postgresql://edificio_5hlu_user:m4NlbpxERlqyxUgS82Bs026mIrIYA6e5@dpg-db5ro4g473hc73c6dppg-a.frankfurt-postgres.render.com/edificio_5hlu?schema=edificio&sslmode=require"

# JWT Secret — debe ser una cadena larga y aleatoria en producción
# Generar con: openssl rand -base64 64
JWT_SECRET="edificio_xyz_super_secure_jwt_secret_key_2026"

# Puerto en el que escucha el servidor Express
PORT=4000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Origen CORS permitido (URL del frontend)
CORS_ORIGIN="http://localhost:3000"

# Tiempo de expiración de sesión por inactividad (en minutos)
SESSION_IDLE_TIMEOUT_MINUTES=30

# Autorización explícita para ejecución de pruebas unitarias y de integración contra la BD compartida
ALLOW_SHARED_DB_TESTS=true

# Programador de Tareas Automáticas (Cron) para Recálculo de Mora (CA10)
# Expresión cron (por defecto: 01:00 AM hora de La Paz todos los días)
MORA_CRON="0 1 * * *"
# Habilitar o deshabilitar ejecución automática (por defecto: false)
MORA_CRON_ENABLED=false

