PORT=4000
NODE_ENV=development

# Cadena de conexión a PostgreSQL (ver docker-compose.yml en la raíz del proyecto)
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<db>
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5432/postgres

# Secreto para firmar los JWT. Usar un valor propio y seguro en cada entorno.
JWT_SECRET=changeme
