# ══════════════════════════════════════════════════════════════
# UBICACIÓN EN EL PROYECTO: /backend/.env.example
# DESCRIPCIÓN: Plantilla de ejemplo. Copiar como /backend/.env
# ══════════════════════════════════════════════════════════════

# Base de Datos PostgreSQL
# Opción 1 (Activa): Supabase Cloud (Modo Transaction Pooler en puerto 6543)
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST.pooler.supabase.com:6543/postgres?schema=edificio&pgbouncer=true&connection_limit=5&pool_timeout=10"
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST.pooler.supabase.com:5432/postgres?schema=edificio"

# Opción 2 (Local): Docker PostgreSQL (descomentar para trabajo offline)
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres?schema=edificio"
# DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres?schema=edificio"

# JWT Secret — debe ser una cadena larga y aleatoria en producción
# Generar con: openssl rand -base64 64
JWT_SECRET="edificio_xyz_super_secure_jwt_secret_key_2026"

# Puerto en el que escucha el servidor Express
PORT=4000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Origen CORS permitido (URL del frontend)
CORS_ORIGIN="http://localhost:3000"

# Tiempo de expiración de sesión por inactividad (en minutos)
SESSION_IDLE_TIMEOUT_MINUTES=30

