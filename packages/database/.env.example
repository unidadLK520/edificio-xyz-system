# ══════════════════════════════════════════════════════════════
# UBICACIÓN EN EL PROYECTO: /packages/database/.env.example
# DESCRIPCIÓN: Plantilla de ejemplo. Copiar como /packages/database/.env
# ══════════════════════════════════════════════════════════════

# Base de Datos PostgreSQL
# Opción 1 (Activa): Supabase Cloud (Modo Transaction Pooler en puerto 6543)
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST.pooler.supabase.com:6543/postgres?schema=edificio&pgbouncer=true&connection_limit=5&pool_timeout=10"
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST.pooler.supabase.com:5432/postgres?schema=edificio"

# Opción 2 (Local): Docker PostgreSQL (descomentar para trabajo offline)
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres?schema=edificio"
# DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres?schema=edificio"
