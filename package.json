{
  "name": "edificio-xyz-system",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "api:dev": "pnpm --filter @edificio-xyz/api dev",
    "web:dev": "pnpm --filter web dev",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:seed": "turbo db:seed",
    "db:studio": "pnpm --filter @edificio-xyz/database db:studio",
    "db:sync-all": "pnpm --filter @edificio-xyz/database db:sync-all",
    "check:t29": "pnpm --filter @edificio-xyz/api check:t29",
    "check:t36": "pnpm --filter @edificio-xyz/api check:t36",
    "check:t37-t38": "pnpm --filter @edificio-xyz/api check:t37-t38"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "turbo": "^2.4.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "bcryptjs"
    ]
  }
}

